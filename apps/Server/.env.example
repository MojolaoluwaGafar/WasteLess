PORT=5050

# MongoDB connection string (MongoDB Atlas: Connect > Drivers).
MONGO_URI=mongodb://127.0.0.1:27017/wasteless
# Optional: the database to use when MONGO_URI doesn't name one.
MONGO_DB_NAME=

# Signs login tokens. Use a long random value; changing it signs everyone out.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_KEY=

# The web app's public URL, for links in emails (password reset, requests).
# Also allowed by CORS. e.g. https://wasteless-client.onrender.com
CLIENT_URL=http://localhost:5173
# Extra browser origins allowed to call the API, comma separated.
CORS_ORIGINS=

# Proxies in front of the server (Render = 1). Leave empty locally.
TRUST_PROXY_HOPS=

# "Today", for expiry dates. Defaults to Africa/Lagos.
APP_TIMEZONE=

# Google sign-in: the OAuth client ID (same value as the Client's VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=

# Cloudinary, for listing photos (cloudinary.com > Settings > API Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Logging: trace | debug | info | warn | error | fatal (default: debug in dev, info in production)
LOG_LEVEL=

# Emails: password resets and request updates.
# brevo (default, use in production) or gmail (local testing; Render's free
# plan blocks outgoing SMTP, so Gmail won't send from there).
EMAIL_PROVIDER=
# Brevo (brevo.com > SMTP & API > API keys). EMAIL_FROM must be a sender
# verified in Brevo. Without both, emails are skipped and logged.
BREVO_API_KEY=
EMAIL_FROM=
# Gmail: the account to send from, and a Google app password for it
# (myaccount.google.com/apppasswords; needs 2-Step Verification on).
APP_EMAIL=
APP_PASSWORD=

# `npm run seed` signs the demo donor in with this password.
SEED_PASSWORD=

# Optional: AI-written "use it up" recipe ideas in the pantry (console.groq.com).
# Without it, ideas come from a built-in guide.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
