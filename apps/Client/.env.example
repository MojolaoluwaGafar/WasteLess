# The API's address. Leave empty for local development (it uses port 5050).
# In production set it to the API's public URL, e.g. https://wasteless-api.onrender.com
VITE_BASE_URL=

# Google sign-in: the OAuth client ID from Google Cloud Console. Leave empty to
# hide the Google button. Add the site's URL to the client's
# "Authorised JavaScript origins".
VITE_GOOGLE_CLIENT_ID=
